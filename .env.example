# =============================================================================
# 复盘簿 环境配置文件
# 复制此文件为 .env 并填写:  cp .env.example .env
# docker compose 启动时会自动读取同级 .env
# =============================================================================

# ---- AI 模型源（可选） ----
# 不配置则应用使用"自动解释"模式（无 AI 分析，其余功能正常）。

# 方式一：直接用 DeepSeek
DEEPSEEK_API_KEY=sk-xxxxxxxx

# 方式二：统一变量（优先级高于 DEEPSEEK_API_KEY），可切换 OpenAI 兼容接口
# AI_PROVIDER=deepseek|openai
# AI_API_KEY=sk-xxxxxxxx
# AI_API_BASE=https://api.openai.com/v1      # openai；deepseek 默认 https://api.deepseek.com
# AI_MODEL=gpt-4o                             # openai；deepseek 默认 deepseek-chat

# ---- 单用户登录（必填） ----
# 生产环境请用以下命令生成安全密钥:
#   openssl rand -hex 32
APP_USERNAME=owner
APP_PASSWORD=请修改为至少12位的强密码
APP_AUTH_SECRET=请修改为至少32位的随机字符串
