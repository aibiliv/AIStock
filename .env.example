# 复制为 .env 后填写；docker compose 会自动加载同级 .env
# AI 模型源配置（可选）。不配置则应用使用"自动解释"模式（无 AI 分析，其余功能正常）。

# 方式一：直接用 DeepSeek（兼容旧字段）
DEEPSEEK_API_KEY=

# 方式二：统一变量（优先级高于 DEEPSEEK_API_KEY），可切换任意 OpenAI 兼容接口：
# AI_PROVIDER=deepseek|openai
# AI_API_KEY=sk-xxxxxxxx
# AI_API_BASE=https://api.openai.com/v1        # openai；deepseek 默认 https://api.deepseek.com
# AI_MODEL=gpt-4o                              # openai；deepseek 默认 deepseek-chat

# 示例：改用 OpenAI
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxxx
# AI_API_BASE=https://api.openai.com/v1
# AI_MODEL=gpt-4o

# 单用户登录（密码至少12位，密钥至少32位随机字符）
APP_USERNAME=owner
APP_PASSWORD=
APP_AUTH_SECRET=
