# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ---- dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
package-lock.json

# ---- testing ----
/coverage

# ---- build outputs (Next.js / Vite + Cloudflare Workers) ----
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
/backups/
.vercel

# ---- vite / typescript caches ----
/.vite
*.tsbuildinfo
next-env.d.ts

# ---- logs (本地开发与服务运行产生的日志) ----
*.log

# ---- env & secrets (切勿提交，含 API 密钥) ----
.env
.env.*
!.env.example
.dev.vars

# ---- OS junk ----
.DS_Store
Thumbs.db
*.pem

# ---- local auth / runtime secrets (会话 cookie 等，切勿提交) ----
.auth-cookie.txt
*.cookie.txt

# ---- personal IDE / agent data (不共享的个人开发数据) ----
.codebuddy/
.workbuddy/
.openai/

# ---- local runtime data ----
# deploy.sh 中说明数据目录为 $PROJECT_DIR/data (D1 SQLite)，属本地运行产物
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# ---- temp / backup files ----
*.bak
*.bak.*
*.tmp

# ---- local scripts (含测试凭证的本地调试脚本) ----
/scripts/repro.mjs

# ---- deploy marker (deploy.sh 记录上次构建的源码 commit) ----
.last_build_commit

# ---- Python (trading_agent/) ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- trading_agent: runtime cache & generated reports ----
trading_agent/cache/
trading_agent/reports/*.csv
trading_agent/reports/*.json
trading_agent/reports/*.md
trading_agent/feedback.jsonl

# ---- trading_agent: 本地联调临时数据 ----
trading_agent/.tmp_cloud/

# ---- trading_agent: 扫描与信号输出（本地运行产物） ----
trading_agent/prefetched.json
trading_agent/scan_payload.json
trading_agent/signals_out.json
trading_agent/watchlist.json

# ---- Playwright (e2e 测试产物) ----
/test-results/
/playwright-report/
