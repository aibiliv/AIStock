# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build outputs (Next.js / Vite / vinext + Cloudflare Worker)
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
.vercel

# vite / typescript caches
/.vite
*.tsbuildinfo
next-env.d.ts

# logs (本地开发与服务运行产生的日志)
*.log

# env & secrets —— 切勿提交，含 API 密钥
.env
.env.*
!.env.example
.dev.vars

# misc
.DS_Store
*.pem

# local auth / runtime secrets (会话 cookie 等，切勿提交)
.auth-cookie.txt
*.cookie.txt

# local IDE / agent project data
.codebuddy/
