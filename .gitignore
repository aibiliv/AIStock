# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build outputs (Next.js / Vite / vinext + Cloudflare Worker)
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
/backups/
.vercel

# vite / typescript caches
/.vite
*.tsbuildinfo
next-env.d.ts

# logs (本地开发与服务运行产生的日志)
*.log

# env & secrets —— 切勿提交，含 API 密钥
.env
.env.*
!.env.example
.dev.vars

# misc
.DS_Store
*.pem

# local auth / runtime secrets (会话 cookie 等，切勿提交)
.auth-cookie.txt
*.cookie.txt

# local IDE / agent project data
.codebuddy/

# local runtime data (Cloudflare Workers / D1 / Miniflare 本地 SQLite 数据库与缓存)
# deploy.sh 中说明数据目录为 $PROJECT_DIR/data (D1 SQLite)，属本地运行产物，切勿提交
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.db

# backup files
*.bak
*.bak.*
*.tmp
package-lock.json

# build state marker (deploy.sh 记录上次构建的源码 commit，勿提交)
.last_build_commit